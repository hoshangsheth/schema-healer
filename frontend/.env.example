# Base URL of the SchemaHealer FastAPI backend.
# This is the only backend address the frontend uses — no URL is
# hardcoded in application code.
#
#   local    http://localhost:8000
#   staging  https://<your-service>.onrender.com
#
# Must NOT include a trailing slash or a path.
NEXT_PUBLIC_API_URL=http://localhost:8000
