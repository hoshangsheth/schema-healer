# ------------------------------------------------------------------
# Backend (server side only, never exposed to the browser)
# ------------------------------------------------------------------

# Base URL of the recovery service. Uploads are proxied here by the
# route handlers in src/app/api/schema.
BACKEND_API_URL=http://127.0.0.1:8000

# Ceiling for a single recovery request, in milliseconds. The AI step
# can take a while, so allow generous headroom.
BACKEND_TIMEOUT_MS=180000

# ------------------------------------------------------------------
# Public (inlined into the client bundle)
# ------------------------------------------------------------------

# Upload size guard, in megabytes. The service imposes no limit of its
# own; this stops a mistaken huge upload from stalling a run.
NEXT_PUBLIC_MAX_UPLOAD_MB=50

# Canonical site URL, used for page metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. When set, a "GitHub" link appears in the navigation.
NEXT_PUBLIC_GITHUB_URL=

# Endpoint the feedback form posts to. Defaults to the project's own
# Formspree form. Set this to blank to hide the feedback section.
NEXT_PUBLIC_FEEDBACK_ENDPOINT=https://formspree.io/f/xeajogkv
